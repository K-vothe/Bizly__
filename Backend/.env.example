# Aplicación
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173
FORCE_HTTPS=false

# Base de datos
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=CAMBIAR_ESTA_CLAVE
DB_NAME=bizly_db
DB_POOL_SIZE=10

# JWT: use valores largos y aleatorios en producción
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_LARGO_Y_ALEATORIO
JWT_REFRESH_SECRET=CAMBIAR_POR_OTRO_SECRETO_LARGO_Y_ALEATORIO
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_DAYS=7

# Correo (opcional en desarrollo; requerido para verificación real por email)
EMAIL_SERVICE=gmail
EMAIL_FROM_NAME=Bizly
EMAIL_USER=
EMAIL_PASS=
# Solo para demostración local. Nunca activar en producción.
DEV_SHOW_EMAIL_CODES=true

# Primer administrador (usar: npm run create-admin)
ADMIN_NAME=Admin
ADMIN_LASTNAME=Bizly
ADMIN_EMAIL=admin@bizly.local
ADMIN_PASSWORD=CAMBIAR_POR_UNA_CLAVE_SEGURA_123
